<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>ParkasaurusResurrection</AssemblyName>
    <LangVersion>latest</LangVersion>
    <!-- Don't put the local project path (with the user name) into the DLL -->
    <PathMap>$(MSBuildProjectDirectory)=ParkasaurusResurrection</PathMap>
    <!-- Override with: dotnet build -p:GameDir=/path/to/Parkasaurus -->
    <GameDir Condition="'$(GameDir)' == ''">$(HOME)/.local/share/Steam/steamapps/common/Parkasaurus</GameDir>
    <ManagedDir>$(GameDir)/Parkasaurus_Data/Managed</ManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Game and BepInEx DLLs: referenced only, never copied into the build output -->
  <ItemGroup>
    <Reference Include="$(GameDir)/BepInEx/core/BepInEx.dll" Private="false" />
    <Reference Include="$(GameDir)/BepInEx/core/0Harmony.dll" Private="false" />
    <Reference Include="$(ManagedDir)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(ManagedDir)/UnityEngine.dll" Private="false" />
    <Reference Include="$(ManagedDir)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)/UnityEngine.AIModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)/UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)/Unity.InputSystem.dll" Private="false" />
    <Reference Include="$(ManagedDir)/UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(ManagedDir)/UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)/UnityEngine.VideoModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)/UnityEngine.ParticleSystemModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)/UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)/UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)/UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)/Unity.TextMeshPro.dll" Private="false" />
  </ItemGroup>

  <!-- After building, copy the mod straight into BepInEx/plugins -->
  <Target Name="CopyToPlugins" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)/BepInEx/plugins" />
  </Target>

</Project>
